<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
		<Nullable>disable</Nullable>

		<CompressionEnabled>false</CompressionEnabled>
		<TrimMode>partial</TrimMode>
		<PublishTrimmed>false</PublishTrimmed>
		<!-- AOT (build with -p:TwAot=true): compiles OUR code, FNA and the .NET libraries to wasm. The player's
		     game assemblies are loaded later and stay interpreted. AOT requires the trimmer; see TwRootEverything. -->
		<RunAOTCompilation Condition="'$(TwAot)' == 'true'">true</RunAOTCompilation>
		<PublishTrimmed Condition="'$(TwAot)' == 'true'">true</PublishTrimmed>

		<NoWarn>IL2026,IL2046,IL2057,IL2062,IL2065,IL2067,IL2070,IL2072,IL2075,IL2087,IL2090</NoWarn>
		<NoWarn>$(NoWarn),SYSLIB0011,CS0169,CS0219,CS0649,CS8981,CA2022</NoWarn>

		<WasmBuildNative>true</WasmBuildNative>
		<WasmEnableThreads>true</WasmEnableThreads>
		<WasmEnableSIMD>true</WasmEnableSIMD>
		<WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>

		<WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
		<WasmBitcodeCompileOptimizationFlag>-O3</WasmBitcodeCompileOptimizationFlag>
		<WasmNativeStrip>true</WasmNativeStrip>
		<WasmStripILAfterAOT>true</WasmStripILAfterAOT>
		<WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>

		<EmccExtraLDFlags>-sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES2 -sFULL_ES3 -sWASMFS -sOFFSCREENCANVAS_SUPPORT</EmccExtraLDFlags>
		<EmccLinkOptimizationFlag>-O3</EmccLinkOptimizationFlag>
		<EmccCompileOptimizationFlag>-O3</EmccCompileOptimizationFlag>
		<EmccEnvironment>web,worker</EmccEnvironment>
		<!-- Terraria + tModLoader need well over the 2 GB default -->
		<EmccMaximumHeapSize>4294901760</EmccMaximumHeapSize>
		<AssemblyName>TerrariaWebLoader</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!-- FNA -->
		<NativeFileReference Include="statics\SDL3.a" />
		<NativeFileReference Include="statics\FNA3D.a" />
		<NativeFileReference Include="statics\libmojoshader.a" />
		<NativeFileReference Include="statics\FAudio.a" />

		<!-- WASMFS -->
		<NativeFileReference Include="Emscripten.c" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include=".\FNA\FNA.Core.csproj" />
		<PackageReference Include="Mono.Cecil" Version="0.11.6" />
		<None Remove=".\FNA\**" />
		<Compile Remove=".\FNA\**" />
		<Content Remove=".\FNA\**" />
		<EmbeddedResource Remove=".\FNA\**" />
	</ItemGroup>
	<!-- tModLoader (loaded later) uses framework APIs our loader never touches: root every assembly so the
	     trimmer removes nothing. -->
	<Target Name="TwRootEverything" BeforeTargets="PrepareForILLink" Condition="'$(TwAot)' == 'true'">
		<ItemGroup>
			<TrimmerRootAssembly Include="@(ManagedAssemblyToLink->'%(Filename)')" />
		</ItemGroup>
	</Target>
</Project>

